# The published library bundle in `lib/` is generated by `npm run build:lib` and committed
# so a `github:` install resolves `exports` without a build step (#146). Mark it generated:
# collapse it in PR diffs and exclude it from language stats. The `lib-fresh` CI job keeps it
# in sync with `src/`. (`-diff` only hides the textual diff; `git diff --quiet` still detects
# drift, so the freshness gate is unaffected.)
lib/** linguist-generated=true -diff

# Stored unified diffs contain significant leading context markers and may need
# to preserve upstream whitespace exactly in removed lines.
*.patch -whitespace
