# Standalone dvipdfmx diagnostic build: same pinned toolchain/source/ports as
# Dockerfile.xetex, without compiling the unrelated XeTeX native/codegen graph.
# Release assembly still uses the reviewed engine-family receipts.
FROM emscripten/emsdk:3.1.46@sha256:2491bc4bf6caf8c41993660822341bc72759cb577363dfe0781f0a2d05f7d357
ARG TEXLIVE_REF
ARG TEXLIVE_YEAR=2026
ENV TEXLIVE_YEAR=$TEXLIVE_YEAR
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential autoconf automake libtool pkg-config git ca-certificates \
    python3 flex bison texinfo clang && rm -rf /var/lib/apt/lists/*
RUN test -n "$TEXLIVE_REF" && mkdir -p /src/texlive-source && \
    cd /src/texlive-source && git init -q && \
    git remote add origin https://github.com/TeX-Live/texlive-source.git && \
    git fetch --depth 1 -q origin "$TEXLIVE_REF" && git checkout -q FETCH_HEAD
COPY build-dvipdfm2.sh dvipdfm-entry.c dvipdfm-stubs.c kpse-hook.c \
    dvipdfm-worker.js xetex-dvipdfm-library.js /src/
COPY dvipdfmx-fixes /src/dvipdfmx-fixes
COPY resolver-evidence.js /src/resolver-evidence.js
WORKDIR /src
ENTRYPOINT ["bash", "/src/build-dvipdfm2.sh"]
