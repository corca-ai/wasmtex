# =============================================================================
# Dockerfile.metafont — Metafont and GFtoPK WASM build environment
# =============================================================================
#
# Both are web2c programs, so a native phase turns their WEB sources into C here and
# build-metafont.sh compiles that C to WebAssembly.
#
# Usage:
#   docker build --platform linux/amd64 -f Dockerfile.metafont \
#     --build-arg TEXLIVE_REF=$(cat texlive-source-2026.ref) -t metafont-wasm .
#   docker run --platform linux/amd64 -v $(pwd)/dist-metafont:/dist metafont-wasm
# =============================================================================

FROM emscripten/emsdk:3.1.46@sha256:2491bc4bf6caf8c41993660822341bc72759cb577363dfe0781f0a2d05f7d357

LABEL description="Metafont WASM build environment (annually pinned TeX Live source)"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential autoconf automake libtool pkg-config git ca-certificates bison flex texinfo \
    && rm -rf /var/lib/apt/lists/*

# ---- TeX Live source (pinned, immutable — single source of truth ref) -------
ARG TEXLIVE_REF
RUN test -n "${TEXLIVE_REF}" || { echo "TEXLIVE_REF build-arg is required"; exit 1; }; \
    echo "=== Fetching pinned TeX Live source ${TEXLIVE_REF} ===" && \
    mkdir -p /src/texlive-source && cd /src/texlive-source && \
    git init -q && \
    git remote add origin https://github.com/TeX-Live/texlive-source.git && \
    git fetch --depth 1 -q origin "${TEXLIVE_REF}" && \
    git checkout -q FETCH_HEAD && \
    echo "=== Source checkout complete ($(git rev-parse HEAD)) ==="

RUN mkdir -p /build/native /dist

# ---- Own glue (COPY after fetch so glue edits don't refetch the source) ------
COPY kpse-hook.c           /src/kpse-hook.c
COPY metafont-bridge.js    /src/metafont-bridge.js
COPY metafont-library.js   /src/metafont-library.js
COPY metafont-screen.c     /src/metafont-screen.c
COPY build-metafont.sh     /src/build-metafont.sh

RUN chmod +x /src/build-metafont.sh
WORKDIR /src
ENTRYPOINT ["bash", "build-metafont.sh"]
