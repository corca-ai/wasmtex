  "formatGeneration": {
    "pdftex": {
      "output": "wasmtex-pdftex.fmt",
      "inputs": [
        "latex.ltx",
        "language.def",
        "hyphen.cfg and referenced hyphenation inputs from the pinned TeX Live 2025 distribution"
      ],
      "procedure": "node scripts/extract-format.mjs"
    },
    "xetex": {
      "output": "wasmtex-xetex.fmt.gz",
      "inputs": [
        "latex.ltx",
        "unicode-data and font configuration inputs loaded by the XeTeX format build"
      ],
      "procedure": "node scripts/extract-xetex-format.mjs followed by gzip -n -9"
    },
    "luahbtex": {
      "output": "wasmtex-luatex.fmt.gz",
      "inputs": [
        "lualatex.ini",
        "latex.ltx",
        "luaotfload and referenced Lua/package inputs loaded by the LuaHBTeX format build"
      ],
      "procedure": "node scripts/extract-luatex-format.mjs followed by gzip -n -9"
    }
  }
}
