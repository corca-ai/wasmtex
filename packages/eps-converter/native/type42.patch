+#[test]
+#[cfg(feature = "pdf-output")]
+fn pdf_keeps_type42_glyphshow_outlines_alongside_encoded_text() {
+    // A single rectangular TrueType contour, in font units.
+    let mut outline: Vec<u8> = [1i16, 0, 0, 500, 600, 3, 0]
+        .into_iter()
+        .flat_map(i16::to_be_bytes)
+        .collect();
+    outline.extend([1; 4]); // on-curve, signed 16-bit deltas
+    for delta in [0i16, 500, 0, -500, 0, 0, 600, 0] {
+        outline.extend(delta.to_be_bytes());
+    }
+    let hex: String = sfnt_with_second_glyph(&outline)
+        .iter()
+        .map(|b| format!("{b:02X}"))
+        .collect();
+    let ps = format!(
+        r#"%!PS
+/TT <<
+  /FontType 42 /FontMatrix [1 0 0 1 0 0] /FontBBox [0 0 0.5 0.6]
+  /Encoding StandardEncoding /CharStrings << /.notdef 0 /square 1 >>
+  /sfnts [<{hex}>]
+>> definefont pop
+/Helvetica findfont 12 scalefont setfont
+72 600 moveto (Encoded text) show
+/TT findfont 100 scalefont setfont
+72 690 moveto /square glyphshow
+showpage
+"#
+    );
+    let pdf = Interpreter::new()
+        .render_to_pdf(ps.as_bytes(), 72.0)
+        .unwrap();
+    let document = stet_pdf_reader::PdfDocument::from_bytes(&pdf).unwrap();
+    let (rgba, width, _) = document.render_page_to_rgba(0, 72.0).unwrap();
+    let pixel = (70 * width as usize + 90) * 4;
+    assert_eq!(&rgba[pixel..pixel + 4], &[0, 0, 0, 255]);
+}
