+#[test]
+fn type42_glyphshow_uses_named_gids_and_advances_the_current_point() {
+    let hex: String = minimal_sfnt().iter().map(|b| format!("{b:02X}")).collect();
+    let ps = format!(
+        r#"%!PS
+/TT <<
+  /FontType 42 /FontMatrix [1 0 0 1 0 0] /FontBBox [0 -0.25 1 0.9]
+  /Encoding StandardEncoding
+  /CharStrings << /.notdef 0 /uni2212 1 >>
+  /sfnts [<{hex}>]
+>> definefont pop
+/TT findfont 12 scalefont setfont
+72 700 moveto /uni2212 glyphshow /absent glyphshow /uni2212 glyphshow
+showpage
+"#
+    );
+    let runs = runs_of(&ps);
+    assert_eq!(runs.len(), 1);
+    let run = &runs[0];
+    assert_eq!(run.glyphs.len(), 3);
+    assert_eq!(glyph_texts(run)[0], "−");
+    assert!(close(run.glyphs[0].advance, (7.2, 0.0)));
+    assert!(close(run.glyphs[1].origin, (79.2, 92.0)));
+    assert!(close(run.glyphs[1].advance, (6.0, 0.0)));
+    assert!(close(run.glyphs[2].origin, (85.2, 92.0)));
+    assert_eq!((run.ascent, run.descent), (900.0, -250.0));
+}
