+fn render_type42_glyphshow(
+    ctx: &mut Context,
+    font: EntityId,
+    charstrings: EntityId,
+    name: stet_core::object::NameId,
+) -> Result<(), PsError> {
+    let (name, entry) = match ctx.dicts.get(charstrings, &DictKey::Name(name)) {
+        Some(entry) => (name, entry),
+        None => {
+            let notdef = ctx.name_cache.n_notdef;
+            let entry = ctx
+                .dicts
+                .get(charstrings, &DictKey::Name(notdef))
+                .ok_or(PsError::InvalidFont)?;
+            (notdef, entry)
+        }
+    };
+    let gid = entry
+        .as_i32()
+        .and_then(|value| u16::try_from(value).ok())
+        .ok_or(PsError::InvalidFont)?;
+    let tt = TrueTypeGlyphs::of(ctx, font);
+    let glyph = tt.glyph_by_gid(ctx, font, gid);
+    let fm = read_font_matrix(ctx, font).multiply(&Matrix::scale(1.0 / tt.upm, 1.0 / tt.upm));
+    let device_point = ctx.gstate.current_point.ok_or(PsError::NoCurrentPoint)?;
+    let ctm = ctx.gstate.ctm;
+    let inverse = ctm.invert().ok_or(PsError::UndefinedResult)?;
+    let (x, y) = inverse.transform_point(device_point.0, device_point.1);
+    let (paint_type, stroke_width) = get_paint_info(ctx, font, &fm, &ctm);
+    if !glyph.segments.is_empty() {
+        let path = transform_segments(&glyph.segments, &fm, x, y);
+        // A name need not have a character code. Keep its vector outline
+        // even on PDF pages where other glyphs are emitted as encoded text.
+        push_glyph_path(
+            ctx,
+            ctm_transform_path(&path, &ctm),
+            paint_type,
+            stroke_width,
+            false,
+        );
+    }
+    let (wx, wy) = fm.transform_delta(glyph.width_x, glyph.width_y);
+    record_glyphshow(
+        ctx,
+        font,
+        &fm,
+        text_record::truetype_metrics(tt.font_data.as_deref()),
+        name,
+        (x, y),
+        (wx, wy),
+    );
+    ctx.gstate.current_point = Some(ctm.transform_point(x + wx, y + wy));
+    Ok(())
+}
