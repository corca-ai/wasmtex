# OS/editor and local agent state
.DS_Store
/.claude/

# Local environment. Commit an explicit .env.example if one is needed.
.env
.env.*
!.env.example

node_modules
dist/
bin/

*.log
.env.local

# Compatibility harness output (generated by scripts/compat/run.mjs)
/compat/report.json
/compat/report.md

# Generated, uploaded to R2 (not committed)
bloom-filter.bin
/xetexfontlist.txt

# Downloaded development assets (in a git worktree these may be local symlinks
# back to the primary checkout).
/public/busytex
/public/fonts
/public/typst-packages
# Development-only capture of TeX Live responses. Release mirrors are generated
# outside Git and must carry texlive-provenance.json.
/public/texlive/

# Engine assets are generated in CI and deployed as versioned release
# artifacts. Keep only the compliance manifest in Git; this prevents an
# uncleared binary or format from becoming part of permanent public history.
/public/wasmtex/*/*
!/public/wasmtex/*/LICENSE-MANIFEST.json
/wasm-build/dist*/

# Per-version engine asset manifest — generated from the actual asset set by
# scripts/gen-asset-manifest.mjs (in CI) and deployed; not committed (would drift).
/public/wasmtex/*/manifest.json

# Playwright
test-results/
.playwright-cli/

# Vitest coverage output (generated by `npm run test:coverage`)
coverage/
